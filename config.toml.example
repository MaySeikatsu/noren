# noren configuration example.
#
# Copy this file to ~/.config/noren/config.toml and edit as you like
# (the legacy ~/.config/zjp/config.toml is still read as a fallback).
# noren works without a config file (all-source picker with defaults);
# this file is for adding [[session]] shortcuts, [[wildcard]] rules,
# blacklists, and per-project preview/startup/layout hooks.

# ---- Global -----------------------------------------------------------------

# Order groups appear in the picker. FIRST entry = closest to the fzf
# prompt/text field; unknown values are appended at the far end.
# Sessions get priority by default; folders come last.
sort_order = ["zellij", "config", "zoxide"]

# Order within the zellij group (again: first = closest to the prompt).
# Subgroups: "pinned" (pinned sessions), "live" (running), "exited"
# (dead, resurrectable).
session_order = ["pinned", "live", "exited"]

# Draw a light hairline between the session area and the folder area.
separator = true

# Pinned folders normally stay in the folder area (front of the dir group,
# right at the hairline). Set true to slot them in next to the pinned
# sessions instead.
pinned_dirs_with_sessions = false

# Session preview style:
#   "live"   — running sessions show what their focused pane displays right
#              now (refreshed while you look); exited sessions and anything
#              that can't be read fall back to "visual". Exited sessions are
#              never contacted, so hovering can't resurrect them.
#   "visual" — the pane layout drawn as boxes labeled with running programs
#   "text"   — the compact tree
# Both layout styles read only the saved layout file. In the picker, ctrl-/
# cycles live → layout → text → off; the preview's label always says what it
# shows (e.g. "▦ layout — session not running" when live isn't possible).
preview_mode = "live"

# Key overview above the prompt: how many lines its compact form may use
# (the most used keys; F1 shows all of them).
header_lines = 2

# Terminal for "open in a new window" (alt-enter). Empty = $TERMINAL, else
# the first of foot, kitty, ghostty, alacritty, wezterm, konsole,
# gnome-terminal, xterm on PATH. A name ("ghostty") or a template with {}
# for the command ("footclient --app-id noren {}").
terminal = ""

# Re-list sessions and folders this often (seconds) while the picker is
# open, so sessions started or ended elsewhere show up. 0 = off.
auto_reload_secs = 60

# Live preview of ALL tabs of a session side by side (each tab's focused
# pane, stacked when the preview is narrow) instead of just the active tab.
live_all_tabs = false

# How often a live preview re-renders while the cursor rests on it (ms).
# 0 = only when the cursor moves.
live_refresh_ms = 1000

# Where the preview sits: beside the list when there's room, above it when
# the terminal is narrow (the list always stays next to the prompt).
# right | left | up | down
preview_position         = "right"
preview_position_compact = "up"

# Hide entries from the picker permanently (ctrl-h hides interactively;
# alt-h shows hidden ones). `noren list hidden` shows only hidden entries.
# Sessions and [[session]] entries match by name; folders match by path —
# exact (`~` allowed) or a glob (`*` one segment, `**` recursive), never by
# bare basename. So "scratch" hides a session named scratch, while
# "**/scratch" hides every scratch folder.
blacklist = ["scratch", "junk", "~/Downloads/**"]

# 1 = basename only ("nixos"), 2 = "parent/child" ("dotfiles/nixos"), etc.
dir_length = 1

# Show icons in the picker: 📁 dir, ▣ live session shown in a terminal right
# now, ▢ live session running in the background, ⊗ exited, ⚙ config,
# 📌 prefix on pinned sessions. Default: true.
icons = true

# Dimmed path after each name in the picker — tells apart random session
# names and folders that share a basename. Default: true.
show_paths = true

# ▣/▢ distinction (detecting attached terminals) costs one parallel
# `zellij action list-clients` round trip (~150-250ms) at picker startup.
# Set false for the instant (~20ms) list; live sessions then all show ▢.
attached_indicator = true

# ---- Snapshots ----------------------------------------------------------------
# `noren snapshot [name]` stores a point-in-time copy of the session's layout
# under ~/.local/state/noren/snapshots/<name>/; `noren restore <name> [index]`
# recreates the session from one (1 = newest, see `noren snapshots`).

# How many snapshots to keep per session (oldest are pruned).
snapshot_keep = 5

# Automatically snapshot pinned sessions: on pin, and on every connect to a
# pinned session. Identical states are not duplicated. Default: false.
auto_snapshot_pinned = false

# ---- Picker keybinds -----------------------------------------------------------
# fzf key names ("ctrl-x", "alt-x", "f2", …); "" disables a bind. The picker
# header is generated from this table, so it always shows what is active.
# These override fzf's own defaults inside noren's picker only (your other
# fzf uses are untouched) — e.g. ctrl-k/ctrl-p normally move up, ctrl-d
# deletes a character. To get one back, bind the action to another key,
# e.g. kill = "alt-k".

[keys]
sessions = "ctrl-t"   # view: zellij sessions
dirs     = "ctrl-z"   # view: zoxide folders
config   = "ctrl-f"   # view: [[session]] entries
all      = "ctrl-a"   # view: everything
reload   = "ctrl-r"   # refresh the current view
pin      = "ctrl-p"   # pin toggle (sessions by name, folders by path)
snapshot = "ctrl-s"   # snapshot menu of the selected session: take one,
                      # restore (⏎), delete (ctrl-d); esc goes back
kill     = "ctrl-k"   # soft kill (layout survives, session resurrectable)
delete   = "ctrl-d"   # hard delete (removes the resurrection data)
preview  = "ctrl-/"   # cycle the preview: live → layout → text → off
help     = "f1"       # full key overview ↔ the compact one
new_window = "alt-enter"  # open the selected entry in a new terminal window
                      # (ctrl-enter sends the same as enter in most terminals)
hide     = "ctrl-h"   # hide / unhide the selected entry (kept in
                      # ~/.local/state/noren/hidden; `noren list hidden`)
hidden   = "alt-h"    # show hidden entries (⊘) in the list, or not
rename   = "ctrl-e"   # rename the selected running session (⏎ applies)
paths    = "alt-p"    # search names only (default) or names + paths
tabs     = "alt-t"    # tab menu of the selected session (⏎ lands in that tab)

# ---- Confirmation -------------------------------------------------------------
# When kill/delete ask before acting (y/N right in the picker prompt; on a
# tty for `noren kill|delete`, skippable with --yes):
#   "always" | "attached" (a terminal shows it right now) |
#   "running" (attached or in the background) | "never"
# Killing or deleting the session you are in switches you away first.

[confirm]
kill   = "attached"
delete = "running"

# ---- Defaults applied when a session/wildcard doesn't override --------------

[default_session]
# Command run in a new pane the first time a session is created.
# Empty = no startup command.
startup_command = ""

# Command used to render the preview pane when a specific one isn't set.
# `{}` is substituted with the entry's path.
preview_command = "eza --all --git --icons --color=always {}"

# Zellij layout name (from ~/.config/zellij/layouts/<name>.kdl). Empty = default.
layout = ""

# ---- Explicit sessions ------------------------------------------------------
# Match by `name` or `path`. Highest precedence.

[[session]]
name            = "nixos"
path            = "~/.config/nixos"
startup_command = "hx"
preview_command = "bat --color=always {}/flake.nix"
layout          = "ide-git"

[[session]]
name            = "downloads"
path            = "~/Downloads"
preview_command = "ls -la {}"

# ---- Wildcard rules ---------------------------------------------------------
# Match paths by glob. First match wins. `**` = recursive; `*` = one segment.
# Applied to zoxide entries and to `noren connect <path>` invocations.

[[wildcard]]
pattern         = "~/Documents/projects/rust/*"
startup_command = "hx ."
preview_command = "eza --tree --level=2 --color=always {}"
layout          = "ide-git"

[[wildcard]]
pattern         = "~/Documents/cws/**"
layout          = "ide"

[[wildcard]]
pattern         = "~/Projects/*"
layout          = "ide"
